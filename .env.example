# ShieldSense Server & Google OAuth Configuration
PORT=3000

# Google Cloud OAuth 2.0 Credentials (From Google Cloud Console: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Exact Redirect URI configured in Google Cloud Console Credentials
REDIRECT_URI=http://localhost:3000/auth/google/callback

# Session Encryption Secret
SESSION_SECRET=shieldsense_secure_cyber_session_key_2026
